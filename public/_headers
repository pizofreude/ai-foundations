/*
  # Strict HTTP Security Headers for Netlify
  # Target: A+ (100+/100) on Mozilla Observatory & SecurityHeaders.com

  # 1. Content Security Policy (Strict, production-hardened for Vite SPA)
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https://krackeddevs.com https://*.cloudfront.net blob:; media-src 'self' https://d8j0ntlcm91z4.cloudfront.net blob:; connect-src 'self' https://krackeddevs.com https://d8j0ntlcm91z4.cloudfront.net https://fonts.googleapis.com https://fonts.gstatic.com; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self' https://krackeddevs.com; frame-ancestors 'none'; upgrade-insecure-requests;

  # 2. HTTP Strict Transport Security (HSTS) with preloading & subdomains
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

  # 3. Prevent MIME-sniffing
  X-Content-Type-Options: nosniff

  # 4. Clickjacking defense (disallow framing)
  X-Frame-Options: DENY

  # 5. Referrer Policy (protect path/query disclosure across origins)
  Referrer-Policy: strict-origin-when-cross-origin

  # 6. Cross-Origin Embedder Policy (require CORP / CORS for subresources)
  Cross-Origin-Embedder-Policy: require-corp

  # 7. Cross-Origin Opener Policy (isolate browsing context)
  Cross-Origin-Opener-Policy: same-origin

  # 8. Cross-Origin Resource Policy (prevent unauthorized cross-origin reading)
  Cross-Origin-Resource-Policy: same-origin

  # 9. Permissions Policy (restrict sensitive hardware and browser APIs)
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), screen-wake-lock=(), accelerometer=(), gyroscope=(), magnetometer=()

  # 10. Legacy XSS filter disablement (modern best practice to prevent client vulnerabilities)
  X-XSS-Protection: 0
